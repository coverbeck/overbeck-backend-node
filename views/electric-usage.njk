{% extends "layouts/base.njk" %}

{% block title %}Electric Usage{% endblock %}

{% block content %}
<h1>Electric &amp; Gas Usage</h1>
<p>PG&amp;E usage data, by billing period.</p>
{% if electricUsageCheckin %}
  {% if electricUsageCheckin.status == 'ok' %}
<p>Last checked: {{ electricUsageCheckin.checkedAtDate }}</p>
  {% else %}
<p>Error checking for new data on {{ electricUsageCheckin.checkedAtDate }}: {{ electricUsageCheckin.message }}</p>
  {% endif %}
{% endif %}

<h2>Electric</h2>
<div style="max-width: 900px">
  <canvas id="electric-chart"></canvas>
</div>
<p>Most recent data: {{ lastElectric }}</p>

<h2>Electric by Day</h2>
<p>Billing period: <span id="period-label"></span> <span class="hint">(click a bar in the Electric chart above to change)</span></p>
<div style="max-width: 900px">
  <canvas id="daily-chart"></canvas>
</div>
<p id="daily-summary"></p>

<h2 id="hourly-heading">Electric by Hour</h2>
<div style="max-width: 900px">
  <canvas id="hourly-chart"></canvas>
</div>

<h2>Solar Savings</h2>
{% macro dollars(v) %}{{ '-' if v < 0 }}${{ (v if v >= 0 else -v).toFixed(2) }}{% endmacro %}
{% if payback.years.length %}
<p>
  {% if payback.paidOffYear %}The panels ({{ dollars(payback.cost) }} after incentives) paid for themselves in the True-Up year ending July {{ payback.paidOffYear }}.
  {% else %}{{ dollars(payback.cost - payback.totalSavings) }} to go before the panels ({{ dollars(payback.cost) }} after incentives) pay for themselves.{% endif %}
  Estimated savings to date: {{ dollars(payback.totalSavings) }}.
</p>
<p class="hint">Estimated electric bill with and without the panels, per NEM True-Up year. Credits and charges offset each other within a year, and at the July True-Up a net credit is forfeited and the delivery minimum bill applies, so each year is settled that way rather than summed period by period. The fixed Base Services Charge (from March 2026) is left out of both sides.</p>
<p class="hint">Each year uses the most detailed data available. <strong>Hourly</strong> years are modeled from hourly usage and solar data on E-TOU-C, including PCIA. <strong>Bill-level</strong> years are estimated from each bill's net kWh plus the panels' daily production, priced at PG&amp;E bundled rates on the plan the house would have been on without solar (tiered E-1, then E-TOU-C from about mid-2022, when PG&amp;E moved customers by default), with PCIA only where its rate is known (2025). 3CE's generation rates are ignored throughout.</p>
<div class="table-scroll">
<table class="data-table savings-table">
  <thead>
    <tr>
      <th>True-Up year</th>
      <th>Solar (kWh)</th>
      <th>Exported (kWh)</th>
      <th>Bill with solar</th>
      <th>Bill without solar</th>
      <th>Saved</th>
      <th>Saved to date</th>
    </tr>
  </thead>
  {% for year in payback.years %}
  <tbody>
    <tr class="year-row">
      <th>
        July {{ year.trueUpYear }}{% if year.inProgress %} <span class="hint">(in progress{% if year.hourly.excludesCurrentPeriod %}; totals exclude the current period{% endif %})</span>{% endif %}
        <br><span class="hint">
          {%- if year.bills %}{{ year.bills.rangeLabel }}{% if year.bills.partial %}, from the install{% endif %} · {% endif -%}
          {%- if year.method == 'hourly' %}hourly{% elif year.method == 'bills' %}bill-level, {{ year.bills.noSolarPlan }}{% endif -%}
        </span>
        {% if year.bills and year.bills.estimatedBills.length %}<br><span class="hint">Missing bill estimated: {{ year.bills.estimatedBills | join(', ') }}</span>{% endif %}
        {% if year.periods.length %}
        <br><button type="button" class="link-button period-toggle" aria-expanded="{{ 'true' if year.inProgress else 'false' }}">{{ year.periods.length }} billing period{{ 's' if year.periods.length != 1 }}{% if year.method == 'bills' %} with hourly data{% endif %}</button>
        {% endif %}
      </th>
      {% if year.savings === null %}
      <th>—</th>
      <th>{{ year.exportKwh.toFixed(1) if year.exportKwh !== null else '—' }}</th>
      <td colspan="4" class="hint">Not computable: solar data incomplete for this True-Up year</td>
      {% else %}
      <th>{{ year.solarKwh.toFixed(0) }}</th>
      <th>{{ year.exportKwh.toFixed(0) if year.exportKwh !== null else '—' }}</th>
      <th>{{ dollars(year.withSolarCost) }}{% if year.minimumApplied %}<br><span class="hint">delivery minimum</span>{% endif %}</th>
      <th>{{ dollars(year.noSolarCost) }}</th>
      <th>{{ dollars(year.savings) }}</th>
      <th>{% if year.cumulativeSavings !== null %}{{ dollars(year.cumulativeSavings) }}{% if year.trueUpYear == payback.paidOffYear %}<br><span class="hint">paid off</span>{% endif %}{% else %}—{% endif %}</th>
      {% endif %}
    </tr>
    {% for row in year.periods %}
    <tr class="period-row"{% if not year.inProgress %} hidden{% endif %}>
      <td>{{ row.label }}{% if row.inProgress %} <span class="hint">(in progress)</span>{% endif %}</td>
      {% if row.savings === null %}
      <td>—</td>
      <td>{{ row.exportKwh.toFixed(1) }}</td>
      <td>{{ dollars(row.actualCost) }}</td>
      <td colspan="3" class="hint">Solar data incomplete ({{ row.solarDays }} of {{ row.days }} days)</td>
      {% else %}
      <td>{{ row.solarKwh.toFixed(1) }}</td>
      <td>{{ row.exportKwh.toFixed(1) }}</td>
      <td>{{ dollars(row.actualCost) }}</td>
      <td>{{ dollars(row.noSolarCost) }}</td>
      <td>{{ dollars(row.savings) }}</td>
      <td></td>
      {% endif %}
    </tr>
    {% endfor %}
  </tbody>
  {% endfor %}
  <tfoot>
    <tr>
      <th>Total, settled years</th>
      <th colspan="4"></th>
      <th>{{ dollars(payback.totalSavings) }}</th>
      <th></th>
    </tr>
  </tfoot>
</table>
</div>
{% else %}
<p>No billing data yet.</p>
{% endif %}

<h2>Natural Gas</h2>
<div style="max-width: 900px">
  <canvas id="gas-chart"></canvas>
</div>
<p>Most recent data: {{ lastGas }}</p>
{% endblock %}

{% block head %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
{% endblock %}

{% block scripts %}
<script>
  for (const button of document.querySelectorAll('.period-toggle')) {
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(expanded));
      for (const row of button.closest('tbody').querySelectorAll('.period-row')) row.hidden = !expanded;
    });
  }

  const periodLabels = {{ periodLabels | dump | safe }};
  const periodFullLabels = {{ periodFullLabels | dump | safe }};
  const periodWindowStarts = {{ periodWindowStarts | dump | safe }};
  const periodWindowEnds = {{ periodWindowEnds | dump | safe }};
  const electricImportByPeriod = {{ electricImportByPeriod | dump | safe }};
  const electricExportByPeriod = {{ electricExportByPeriod | dump | safe }};
  const electricCostByPeriod = {{ electricCostByPeriod | dump | safe }};
  const solarKwhByPeriod = {{ solarKwhByPeriod | dump | safe }};
  const gasThermsByPeriod = {{ gasThermsByPeriod | dump | safe }};
  const gasCostByPeriod = {{ gasCostByPeriod | dump | safe }};
  const electricDailyDates = {{ electricDailyDates | dump | safe }};
  const electricDailyImportKwh = {{ electricDailyImportKwh | dump | safe }};
  const electricDailyExportKwh = {{ electricDailyExportKwh | dump | safe }};
  const electricDailyCost = {{ electricDailyCost | dump | safe }};
  const solarDailyDates = {{ solarDailyDates | dump | safe }};
  const solarDailyKwh = {{ solarDailyKwh | dump | safe }};
  const solarKwhByDate = new Map(solarDailyDates.map((date, i) => [date, solarDailyKwh[i]]));

  const NET_IMPORT_COLOR = '#4e79a7';
  const NET_EXPORT_COLOR = '#59a14f';
  const SOLAR_COLOR = '#ffc107';
  const COST_COLOR = '#e63946';
  const MONTH_ABBR = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  function formatDayLabel(dateStr) {
    const [, month, day] = dateStr.split('-').map(Number);
    return `${MONTH_ABBR[month - 1]} ${day}`;
  }

  // Net (import - export) drives bar direction/color, so it's obvious at a glance whether a
  // period/day was net-imported (drew more from the grid) or net-exported (sent more to it),
  // matching PG&E's own NEM chart. This also happens to be the answer to "did I use more
  // electricity than I generated": under net metering, home consumption minus solar generation
  // reduces algebraically to import minus export (self-consumed solar cancels out on both
  // sides), so the bar's color/sign already is that comparison — no separate solar accounting
  // needed for it. Raw import/export/cost detail moves into the tooltip so nothing is lost
  // relative to a two-bar view. Shared by the per-period, per-day, and per-hour charts; solarArr
  // is optional and, when given, overlays generation as a thin line for context only (not part
  // of the net comparison itself).
  function makeNetUsageChart(canvasId, labels, fullLabels, importArr, exportArr, costArr, autoSkipTicks, onBarClick, tooltipTitleFn, solarArr, showTotalCostInTooltip) {
    const netArr = importArr.map((v, i) => v - exportArr[i]);
    return new Chart(document.getElementById(canvasId), {
      data: {
        labels,
        datasets: [
          {
            type: 'bar',
            label: 'Net Grid Usage (kWh)',
            data: netArr,
            yAxisID: 'y',
            backgroundColor: netArr.map((v) => (v >= 0 ? NET_IMPORT_COLOR : NET_EXPORT_COLOR)),
          },
          ...(solarArr ? [{
            type: 'line',
            label: 'Solar Generation (kWh)',
            data: solarArr,
            yAxisID: 'y',
            borderColor: SOLAR_COLOR,
            backgroundColor: SOLAR_COLOR,
          }] : []),
          {
            type: 'line',
            label: 'Cost ($)',
            data: costArr,
            yAxisID: 'y1',
            borderColor: COST_COLOR,
            backgroundColor: COST_COLOR,
          },
        ],
      },
      options: {
        onClick: onBarClick ? (evt, _elements, chart) => {
          const points = chart.getElementsAtEventForMode(evt, 'index', { intersect: false }, true);
          if (points.length > 0) onBarClick(points[0].index);
        } : undefined,
        onHover: onBarClick ? (evt, elements) => {
          evt.native.target.style.cursor = elements.length ? 'pointer' : 'default';
        } : undefined,
        plugins: {
          legend: {
            labels: {
              generateLabels: (chart) => {
                const base = Chart.defaults.plugins.legend.labels.generateLabels(chart);
                const netEntries = [
                  { text: 'Net import (used more than generated)', fillStyle: NET_IMPORT_COLOR, strokeStyle: NET_IMPORT_COLOR },
                  { text: 'Net export (generated more than used)', fillStyle: NET_EXPORT_COLOR, strokeStyle: NET_EXPORT_COLOR },
                ];
                const rest = base.filter((item) => item.text !== 'Net Grid Usage (kWh)');
                return [...netEntries, ...rest];
              },
            },
          },
          tooltip: {
            callbacks: {
              title: (items) => {
                const label = fullLabels[items[0].dataIndex];
                return tooltipTitleFn ? tooltipTitleFn(label) : label;
              },
              label: (ctx) => {
                const datasetLabel = ctx.dataset.label;
                if (datasetLabel === 'Cost ($)') return `Cost: $${ctx.parsed.y.toFixed(2)}`;
                if (datasetLabel === 'Solar Generation (kWh)') {
                  return ctx.parsed.y === null ? 'Solar generation: no data' : `Solar generation: ${ctx.parsed.y.toFixed(1)} kWh`;
                }
                const i = ctx.dataIndex;
                const net = ctx.parsed.y;
                const solarValue = solarArr ? solarArr[i] : undefined;
                return [
                  `Net: ${net >= 0 ? 'imported' : 'exported'} ${Math.abs(net).toFixed(1)} kWh`,
                  `Import: ${importArr[i].toFixed(1)} kWh`,
                  `Export: ${exportArr[i].toFixed(1)} kWh`,
                  ...(solarArr ? [`Solar generation: ${solarValue === null ? 'no data' : solarValue.toFixed(1) + ' kWh'}`] : []),
                  ...(showTotalCostInTooltip ? [`Cost: $${costArr[i].toFixed(2)}`] : []),
                ];
              },
            },
          },
        },
        scales: {
          x: { type: 'category', ticks: { maxRotation: 0, minRotation: 0, autoSkip: autoSkipTicks } },
          y: { type: 'linear', position: 'left', title: { display: true, text: 'Net kWh (import - export)' } },
          y1: {
            type: 'linear',
            position: 'right',
            title: { display: true, text: '$' },
            grid: { drawOnChartArea: false },
          },
        },
      },
    });
  }

  // Single-series bar+line chart for gas, which has no export to net against.
  // Shared by the per-period and per-day gas charts.
  function makeUsageChart(canvasId, labels, fullLabels, valueArr, costArr, valueLabel, valueAxisLabel, autoSkipTicks) {
    return new Chart(document.getElementById(canvasId), {
      data: {
        labels,
        datasets: [
          {
            type: 'bar',
            label: valueLabel,
            data: valueArr,
            yAxisID: 'y',
          },
          {
            type: 'line',
            label: 'Cost ($)',
            data: costArr,
            yAxisID: 'y1',
            borderColor: COST_COLOR,
            backgroundColor: COST_COLOR,
          },
        ],
      },
      options: {
        plugins: {
          tooltip: {
            callbacks: {
              title: (items) => fullLabels[items[0].dataIndex],
            },
          },
        },
        scales: {
          x: { type: 'category', ticks: { maxRotation: 0, minRotation: 0, autoSkip: autoSkipTicks } },
          y: { type: 'linear', position: 'left', title: { display: true, text: valueAxisLabel } },
          y1: {
            type: 'linear',
            position: 'right',
            title: { display: true, text: '$' },
            grid: { drawOnChartArea: false },
          },
        },
      },
    });
  }

  makeNetUsageChart(
    'electric-chart',
    periodLabels,
    periodFullLabels,
    electricImportByPeriod,
    electricExportByPeriod,
    electricCostByPeriod,
    false,
    (i) => renderDailyChart(i),
    undefined,
    solarKwhByPeriod,
    true
  );

  function dailyDataForPeriod(index) {
    const start = periodWindowStarts[index];
    const end = periodWindowEnds[index];
    const labels = [];
    const fullLabels = [];
    const importArr = [];
    const exportArr = [];
    const costArr = [];
    const solarArr = [];
    for (let i = 0; i < electricDailyDates.length; i++) {
      const date = electricDailyDates[i];
      if (date >= start && (end === null || date < end)) {
        labels.push(formatDayLabel(date));
        fullLabels.push(date);
        importArr.push(electricDailyImportKwh[i]);
        exportArr.push(electricDailyExportKwh[i]);
        costArr.push(electricDailyCost[i]);
        solarArr.push(solarKwhByDate.has(date) ? solarKwhByDate.get(date) : null);
      }
    }
    return { labels, fullLabels, importArr, exportArr, costArr, solarArr };
  }

  const periodLabelEl = document.getElementById('period-label');

  function formatSignedDollars(v) {
    return (v < 0 ? '-$' : '$') + Math.abs(v).toFixed(2);
  }

  function renderDailySummary(importArr, exportArr, costArr) {
    const totalImport = importArr.reduce((sum, v) => sum + v, 0);
    const totalExport = exportArr.reduce((sum, v) => sum + v, 0);
    const totalCost = costArr.reduce((sum, v) => sum + v, 0);
    const net = totalImport - totalExport;
    const direction = net >= 0 ? 'imported' : 'exported';
    document.getElementById('daily-summary').textContent =
      `This period: net ${direction} ${Math.abs(net).toFixed(1)} kWh (cost: ${formatSignedDollars(totalCost)})`;
  }

  const MONTH_FULL = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const WEEKDAY_FULL = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

  function formatWeekdayDateLabel(dateStr) {
    const [year, month, day] = dateStr.split('-').map(Number);
    const weekday = WEEKDAY_FULL[new Date(Date.UTC(year, month - 1, day)).getUTCDay()];
    return `${weekday} ${MONTH_FULL[month - 1]} ${day}`;
  }

  function ordinal(n) {
    if (n % 10 === 1 && n % 100 !== 11) return `${n}st`;
    if (n % 10 === 2 && n % 100 !== 12) return `${n}nd`;
    if (n % 10 === 3 && n % 100 !== 13) return `${n}rd`;
    return `${n}th`;
  }

  function formatHeadingDayLabel(dateStr) {
    const [, month, day] = dateStr.split('-').map(Number);
    return `${MONTH_FULL[month - 1]} ${ordinal(day)}`;
  }

  function formatHourLabel(startTime) {
    const h = Number(startTime.split(':')[0]);
    const period = h < 12 ? 'AM' : 'PM';
    const h12 = h % 12 === 0 ? 12 : h % 12;
    return `${h12} ${period}`;
  }

  let hourlyChart = null;
  let hourlyChartRequestId = 0;
  async function renderHourlyChart(date) {
    const requestId = ++hourlyChartRequestId;
    const res = await fetch(`/api/electric-usage/hourly?date=${encodeURIComponent(date)}`);
    const data = await res.json();
    if (requestId !== hourlyChartRequestId) return; // a newer request superseded this one

    if (hourlyChart) hourlyChart.destroy();
    const labels = data.startTime.map(formatHourLabel);
    const fullLabels = data.startTime.map((t, i) => `${date} ${t}–${data.endTime[i]}`);
    hourlyChart = makeNetUsageChart('hourly-chart', labels, fullLabels, data.importKwh, data.exportKwh, data.cost, true, undefined, undefined, data.solarKwh);
    document.getElementById('hourly-heading').textContent = `Electric by Hour — ${formatHeadingDayLabel(date)}`;
  }

  let dailyChart = null;
  function renderDailyChart(index) {
    periodLabelEl.textContent = periodFullLabels[index];
    if (dailyChart) dailyChart.destroy();
    const { labels, fullLabels, importArr, exportArr, costArr, solarArr } = dailyDataForPeriod(index);
    dailyChart = makeNetUsageChart('daily-chart', labels, fullLabels, importArr, exportArr, costArr, true, (i) => {
      renderHourlyChart(fullLabels[i]);
    }, formatWeekdayDateLabel, solarArr);
    renderDailySummary(importArr, exportArr, costArr);
    if (fullLabels.length > 0) renderHourlyChart(fullLabels[fullLabels.length - 1]);
  }

  const defaultPeriodIndex = periodFullLabels.length - 1;
  renderDailyChart(defaultPeriodIndex);

  makeUsageChart('gas-chart', periodLabels, periodFullLabels, gasThermsByPeriod, gasCostByPeriod, 'Usage (therms)', 'therms', false);
</script>
{% endblock %}
