{% extends "layouts/base.njk" %}

{% block title %}Weather Forecast{% endblock %}

{% macro leadLabel(hours) %}{% if hours == 0 %}Latest{% elif hours == 24 %}1 day ahead{% else %}{{ hours }} h ahead{% endif %}{% endmacro %}

{% block content %}
<h1>My Weather</h1>
{% include "partials/weather-tabs.njk" %}

{% if outlook %}
<div class="outlook">
  {% for period in outlook.periods %}
  <p><strong>{{ period.label }}:</strong> {{ period.text }}</p>
  {% endfor %}
</div>
{% endif %}

<p>
  Forecasts for my station's location from four sources, plus our own estimate, saved
  every hour, alongside what the station actually recorded. Left of the dashed "now" line, each forecast line
  shows what the source predicted in advance for that hour; right of it, its forecast
  for the hours ahead. Darker shading marks night, lighter shading the twilight between
  dawn and sunrise and between sunset and dusk.
</p>

<div class="chart-options">
  <span>Range:</span>
  {% for d in rangeDays %}
  <a href="?days={{ d }}&amp;lead={{ lead }}"{% if d == days %} class="active" aria-current="true"{% endif %}>{{ d }} day{% if d > 1 %}s{% endif %}</a>
  {% endfor %}
</div>
<div class="chart-options">
  <span>Forecast made:</span>
  {% for h in leadHours %}
  <a href="?days={{ days }}&amp;lead={{ h }}"{% if h == lead %} class="active" aria-current="true"{% endif %}>{{ leadLabel(h) }}</a>
  {% endfor %}
</div>
<p class="hint">
  {% if lead == 0 %}
  "Latest" uses the newest forecast made before each hour.
  {% elif lead == 24 %}
  "1 day ahead" uses Open-Meteo's archive of forecasts made about a day before each
  hour, which covers the three models but not NWS, so the average is of the three.
  {% else %}
  "{{ leadLabel(lead) }}" uses the newest forecast made at least {{ lead }} hours before each hour,
  the forecast you'd have had that far in advance.
  {% endif %}
  The average never includes our estimate, which is built from NWS, NBM and HRRR. Click a legend
  entry to show or hide a line. The temperature chart starts with just my station and
  our estimate; the other charts start with the station and the average.
</p>

{% if comparison.lines.length %}
<p class="hint">
  To look closer, tap a day in the "Show" row, which stays at the top of the screen as
  you scroll, or pinch (Ctrl-scroll on a computer) on a chart to zoom and drag sideways
  to move along. Every chart follows.
</p>
<div class="chart-options zoom-bar" id="zoom-bar"></div>

<h2>Temperature</h2>
<div style="max-width: 900px">
  <canvas id="temp-chart"></canvas>
</div>

{% if comparison.scores.length %}
<h3>How the forecasts did</h3>
<div class="table-scroll">
  <table class="data-table">
    <thead>
      <tr><th>Forecast</th><th>Hours</th><th>Temp bias</th><th>Temp miss</th><th>Dew pt bias</th><th>Dew pt miss</th></tr>
    </thead>
    <tbody>
      {% for row in comparison.scores %}
      <tr><td>{{ row.label }}</td><td>{{ row.hours }}</td><td>{{ row.tempBias }}</td><td>{{ row.tempMiss }}</td><td>{{ row.dewpointBias }}</td><td>{{ row.dewpointMiss }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<p class="hint">
  Past hours in the range, against the station's reading at the top of each hour, sorted
  by temperature miss. Bias is the average of forecast minus actual (positive means the
  forecast ran high); miss is the average size of the error either way. The average is an
  equal-weight mean of the four fetched sources and doesn't include our estimate. Our
  estimate is newer than the others, so it may cover fewer hours.
</p>
{% endif %}

<h2>Forecasts made in advance</h2>
<p>
  How one forecast changed as each hour got closer: its forecast made about a day
  before (the models only), 12 hours before, 6 hours before and about an hour before,
  against what the station recorded. "Average" is the mean of the fetched forecasts and
  doesn't include our estimate, which has its own button.
</p>
<div class="chart-options" id="lead-sources">
  <span>Forecast:</span>
  {% for f in comparison.leadComparison %}
  <button type="button" data-key="{{ f.key }}"{% if loop.first %} class="active" aria-pressed="true"{% else %} aria-pressed="false"{% endif %}>{{ f.label }}</button>
  {% endfor %}
</div>
<div style="max-width: 900px">
  <canvas id="lead-chart"></canvas>
</div>

<h2>Gap between temperature and dew point</h2>
<div style="max-width: 900px">
  <canvas id="spread-chart"></canvas>
</div>
<p class="hint">
  How far the air is from saturation. When the temperature falls to within
  {{ comparison.fogSpreadF }}°F of the dew point (the shaded band at the bottom), dew or
  fog is likely. Forecast lines use each source's own temperature and dew point. The
  faint dashed line is the station's temperature, on the right-hand scale; hover over a
  point to see the temperature and dew point behind each gap.
</p>

<h2>Clouds</h2>
<div style="max-width: 900px">
  <canvas id="cloud-chart"></canvas>
</div>
<p class="hint">
  Solid lines are total cloud cover; dashed lines are low cloud (fog and marine layer),
  which only HRRR and ECMWF forecast, so the average leaves it out. Station humidity near
  100% usually means fog.
</p>

<h2>Rain</h2>
{% if comparison.rain.show %}
<div style="max-width: 900px">
  <canvas id="rain-chart"></canvas>
</div>
<p class="hint">
  Bars are the rain my station recorded in each hour; solid lines are each forecast's
  amount for the hour, dashed lines its chance of rain (right-hand scale). Hovering
  over an hour shows the hour it starts at. NWS gives amounts for blocks of about six
  hours, spread evenly over them here, and HRRR's chance of rain is left out, since
  Open-Meteo copies it from NBM. Forecast amounts were first saved on Oct 20, 2026.
</p>

{% if comparison.rainScores.length %}
<h3>How the rain forecasts did</h3>
<div class="table-scroll">
  <table class="data-table">
    <thead>
      <tr><th>Forecast</th><th>Hours</th><th>Forecast total</th><th>Recorded total</th><th>Rainy hours caught</th><th>Missed</th><th>False alarms</th><th>Chance when rainy</th><th>Chance when dry</th></tr>
    </thead>
    <tbody>
      {% for row in comparison.rainScores %}
      <tr><td>{{ row.label }}</td><td>{{ row.hours }}</td><td>{{ row.forecastTotal }}</td><td>{{ row.recordedTotal }}</td><td>{{ row.caught }}</td><td>{{ row.missed }}</td><td>{{ row.falseAlarms }}</td><td>{{ row.chanceWhenRainy }}</td><td>{{ row.chanceWhenDry }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<p class="hint">
  Past hours in the range with both a forecast amount and a station measurement. An
  hour with at least 0.01 in counts as rainy. "Missed" is a rainy hour the forecast had
  as dry; a false alarm is the reverse. The chance columns are the forecast's average
  chance of rain in the hours that turned out rainy and dry: a good forecast has a high
  first number and a low second one. Sorted by missed plus false-alarm hours.
</p>
{% endif %}
{% else %}
<p>
  No rain recorded or forecast for these days{% if comparison.rain.maxChancePct %} (the
  highest chance of rain forecast was {{ comparison.rain.maxChancePct | round }}%){% endif %}.
</p>
{% endif %}

<p class="hint">
  Forecasts last fetched: <span class="local-time" data-iso="{{ comparison.lastFetchedAt }}"></span>
</p>
{% else %}
<p>No forecast data yet.</p>
{% endif %}

<h2>Sources</h2>
<ul>
  <li><strong>NWS</strong>: the National Weather Service's forecast for the area.</li>
  <li><strong>HRRR</strong>: NOAA's High-Resolution Rapid Refresh model (3 km grid, updated hourly).</li>
  <li><strong>NBM</strong>: NOAA's National Blend of Models, a blend of many models (2.5 km).</li>
  <li><strong>ECMWF</strong>: the European Centre's global model (about 25 km).</li>
  <li>
    <strong>Our estimate</strong>: made every hour from the latest forecasts and
    the station's recent readings, and saved as made, so it's scored like the others.
    Past hours show the estimate as it was at the time, not recomputed with the
    current method.
    <ul>
      <li>
        <strong>Since 4 pm on Oct 20, 2026</strong>: the average of the latest NWS, NBM
        and HRRR temperature forecasts, corrected for how that average has done over
        the last two weeks: its typical bias at each lead time, how much of its
        current error tends to carry into the hours ahead, and, for daytime hours, how
        its error varies by hour of the day (it has run warm in the mornings and cool
        in the afternoons). ECMWF is left out, since it has missed by the most here.
        The corrections start small and get more weight as data builds up.
      </li>
      <li>
        <strong>Oct 12 to 4 pm on Oct 20, 2026</strong>: HRRR alone, with the same
        kinds of corrections fitted to HRRR, plus an hour-of-day correction taken from
        archived HRRR day-ahead forecasts for this time of year since 2024.
        Scores for ranges that include these days mix the two methods.
      </li>
    </ul>
  </li>
</ul>
<p class="hint">
  Forecast data from the National Weather Service and
  <a href="https://open-meteo.com/">Open-Meteo.com</a> (HRRR, NBM and ECMWF).
</p>
{% endblock %}

{% block head %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8/hammer.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2/dist/chartjs-plugin-zoom.min.js"></script>
{% endblock %}

{% block scripts %}
<script>
  for (const el of document.querySelectorAll('.local-time')) {
    el.textContent = new Intl.DateTimeFormat(undefined, {
      month: 'numeric',
      day: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
    }).format(new Date(el.dataset.iso));
  }

  const comparison = {{ comparison | dump | safe }};
  const COLORS = {
    average: '#8a8a8a',
    nws: '#1a73e8',
    om_hrrr: '#d93025',
    om_nbm: '#188038',
    om_ecmwf: '#e37400',
    estimate: '#8e24aa',
  };
  const STATION_COLOR = '#202020';

  // Night and twilight shading behind the lines, and a dashed vertical line at the
  // current time.
  const SHADES = [
    { bands: comparison.sun.night, fill: 'rgba(60, 80, 140, 0.12)' },
    { bands: comparison.sun.twilight, fill: 'rgba(60, 80, 140, 0.05)' },
  ];
  const overlays = {
    id: 'overlays',
    beforeDatasetsDraw(chart) {
      const { ctx, chartArea } = chart;
      const x = chart.scales.x;
      ctx.save();
      for (const { bands, fill } of SHADES) {
        ctx.fillStyle = fill;
        for (const band of bands) {
          const left = Math.max(x.getPixelForValue(Date.parse(band.start)), chartArea.left);
          const right = Math.min(x.getPixelForValue(Date.parse(band.end)), chartArea.right);
          if (right > left) {
            ctx.fillRect(left, chartArea.top, right - left, chartArea.bottom - chartArea.top);
          }
        }
      }
      ctx.restore();
    },
    afterDatasetsDraw(chart) {
      const nowX = chart.scales.x.getPixelForValue(Date.parse(comparison.now));
      const { top, bottom, left, right } = chart.chartArea;
      if (nowX < left || nowX > right) return; // zoomed away from now
      const { ctx } = chart;
      ctx.save();
      ctx.strokeStyle = '#888';
      ctx.setLineDash([4, 4]);
      ctx.beginPath();
      ctx.moveTo(nowX, top);
      ctx.lineTo(nowX, bottom);
      ctx.stroke();
      ctx.restore();
    },
  };

  function line(label, data, color, extra = {}) {
    return { label, data, borderColor: color, backgroundColor: color, pointRadius: 0, borderWidth: 2, ...extra };
  }

  // The average and our estimate are shown and drawn thicker; the individual
  // sources start hidden. The temperature chart starts with only our estimate.
  function forecastLine(forecast, label, data, extra = {}) {
    const featured = forecast.key === 'average' || forecast.key === 'estimate';
    return line(label, data, COLORS[forecast.key], {
      borderWidth: featured ? 3 : 2,
      hidden: !featured,
      ...extra,
    });
  }

  // Hover shows every visible line at the pointer's time: each line's point nearest
  // that time, if one is within 30 minutes. The built-in modes don't fit, since the
  // station has a point every 5 minutes and the forecasts one an hour, so the
  // nearest point overall is nearly always the station's.
  const SAME_TIME_MS = 30 * 60 * 1000;
  Chart.Interaction.modes.sameTime = (chart, event) => {
    const time = chart.scales.x.getValueForPixel(event.x);
    chart.$hover = { time, event };
    const items = [];
    chart.data.datasets.forEach((dataset, datasetIndex) => {
      if (!chart.isDatasetVisible(datasetIndex)) return;
      let nearest = -1;
      let nearestDistance = Infinity;
      dataset.data.forEach((point, index) => {
        const distance = Math.abs(Date.parse(point.x) - time);
        if (point.y !== null && distance < nearestDistance) {
          nearest = index;
          nearestDistance = distance;
        }
      });
      if (nearest >= 0 && nearestDistance <= SAME_TIME_MS) {
        items.push({ element: chart.getDatasetMeta(datasetIndex).data[nearest], datasetIndex, index: nearest });
      }
    });
    return items;
  };

  // A sunrise or sunset near the pointer, for the tooltip's footer: within 30
  // minutes, or a few pixels on the wider ranges where 30 minutes is a sliver.
  const SUN_LABELS = { sunrise: 'Sunrise', sunset: 'Sunset' };
  function sunFooter(items) {
    const chart = items[0]?.chart;
    if (!chart?.$hover) return '';
    const { time, event } = chart.$hover;
    const reach = Math.max(SAME_TIME_MS, Math.abs(chart.scales.x.getValueForPixel(event.x + 6) - time));
    return comparison.sun.events
      .filter(({ at }) => Math.abs(Date.parse(at) - time) <= reach)
      .map(({ type, at }) => `${SUN_LABELS[type]} ${new Date(at).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`)
      .join('\n');
  }

  // Zooming: every chart shows the same span of time. Pinching or Ctrl-scrolling a
  // chart zooms it and dragging moves along, both on the time axis only; when the
  // gesture ends, the other charts follow. The day buttons set the span directly.
  // Charts only take vertical drags for page scrolling, so a sideways drag moves
  // the chart and a pinch zooms the chart rather than the page.
  Hammer.defaults.touchAction = 'pan-y';
  const HOUR_MS = 3600 * 1000;
  const RANGE = { min: Date.parse(comparison.range.start), max: Date.parse(comparison.range.end) };
  const MIN_SPAN_MS = 2 * HOUR_MS;
  const charts = [];
  let view = { ...RANGE };
  const zoomButtons = []; // the "Show" row's day buttons, with their spans
  let stepBack;
  let stepForward;

  // Ticks by the day over spans of more than two days, else by the hour, with
  // midnights labeled by date either way.
  const unitFor = ({ min, max }) => (max - min > 48 * HOUR_MS ? 'day' : 'hour');

  function showSpan(min, max) {
    const span = Math.min(Math.max(max - min, MIN_SPAN_MS), RANGE.max - RANGE.min);
    const start = Math.min(Math.max(min, RANGE.min), RANGE.max - span);
    view = { min: start, max: start + span };
    for (const chart of charts) {
      chart.options.scales.x.time.unit = unitFor(view);
      chart.zoomScale('x', view, 'none');
    }
    updateZoomBar();
  }

  const followGesture = ({ chart }) => showSpan(chart.scales.x.min, chart.scales.x.max);

  function chartOptions(yTitle, yExtra = {}) {
    return {
      interaction: { mode: 'sameTime', intersect: false },
      plugins: {
        tooltip: { callbacks: { footer: sunFooter } },
        zoom: {
          limits: { x: { min: 'original', max: 'original', minRange: MIN_SPAN_MS } },
          zoom: {
            mode: 'x',
            pinch: { enabled: true },
            wheel: { enabled: true, modifierKey: 'ctrl' },
            onZoomComplete: followGesture,
          },
          pan: { enabled: true, mode: 'x', onPanComplete: followGesture },
        },
      },
      scales: {
        x: {
          type: 'time',
          min: comparison.range.start,
          max: comparison.range.end,
          time: {
            unit: unitFor(RANGE),
            displayFormats: { hour: 'ha', day: 'EEE M/d' },
            tooltipFormat: 'EEE h a',
          },
          ticks: { major: { enabled: true }, font: (c) => (c.tick?.major ? { weight: 'bold' } : {}) },
        },
        y: { title: { display: true, text: yTitle }, ...yExtra },
      },
    };
  }

  if (comparison.lines.length) {
    charts.push(new Chart(document.getElementById('temp-chart'), {
      type: 'line',
      data: {
        datasets: [
          line('My station', comparison.station.temp, STATION_COLOR, { borderWidth: 3 }),
          // Only our estimate is shown at first; the average and sources are a click away.
          ...comparison.lines.map((f) => forecastLine(f, f.label, f.temp, { hidden: f.key !== 'estimate' })),
        ],
      },
      options: chartOptions('°F'),
      plugins: [overlays],
    }));

    // Darker and solid for the shortest lead, lighter and dotted for the longest.
    const LEAD_STYLES = {
      0: { alpha: 1, dash: [], label: 'Latest (about 1 h ahead)' },
      6: { alpha: 0.65, dash: [8, 4], label: '6 h ahead' },
      12: { alpha: 0.4, dash: [2, 3], label: '12 h ahead' },
      24: { alpha: 0.25, dash: [1, 3], label: '1 day ahead' },
    };

    function withAlpha(hex, alpha) {
      const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
      return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    }

    function leadDatasets(key) {
      const forecast = comparison.leadComparison.find((f) => f.key === key);
      return [
        line('My station', comparison.station.temp, STATION_COLOR, { borderWidth: 3 }),
        ...forecast.leads.map(({ lead, temp }) => {
          const style = LEAD_STYLES[lead];
          return line(`${forecast.label} ${style.label}`, temp, withAlpha(COLORS[key], style.alpha), {
            borderDash: style.dash,
          });
        }),
      ];
    }

    const leadChart = new Chart(document.getElementById('lead-chart'), {
      type: 'line',
      data: { datasets: leadDatasets(comparison.leadComparison[0].key) },
      options: chartOptions('°F'),
      plugins: [overlays],
    });
    charts.push(leadChart);

    for (const button of document.querySelectorAll('#lead-sources button')) {
      button.addEventListener('click', () => {
        for (const other of document.querySelectorAll('#lead-sources button')) {
          other.classList.toggle('active', other === button);
          other.setAttribute('aria-pressed', String(other === button));
        }
        leadChart.data.datasets = leadDatasets(button.dataset.key);
        leadChart.update();
      });
    }

    // Band from 0 up to the fog threshold, drawn behind the lines.
    const fogBand = {
      id: 'fogBand',
      beforeDatasetsDraw(chart) {
        const { ctx, chartArea } = chart;
        const y = chart.scales.y;
        const top = Math.max(y.getPixelForValue(comparison.fogSpreadF), chartArea.top);
        const bottom = Math.min(y.getPixelForValue(0), chartArea.bottom);
        ctx.save();
        ctx.fillStyle = 'rgba(120, 120, 120, 0.15)';
        ctx.fillRect(chartArea.left, top, chartArea.right - chartArea.left, bottom - top);
        ctx.fillStyle = '#555';
        ctx.font = '12px sans-serif';
        ctx.textBaseline = 'middle';
        ctx.fillText('Dew or fog likely', chartArea.left + 6, (top + bottom) / 2);
        ctx.restore();
      },
    };

    // Temperature and dew point by timestamp, for the tooltip of each gap line.
    function readings(temp, dewpoint) {
      const byX = new Map(temp.map((p) => [p.x, { temp: p.y, dewpoint: null }]));
      for (const p of dewpoint) {
        const r = byX.get(p.x);
        if (r) r.dewpoint = p.y;
      }
      return byX;
    }

    const degrees = (v) => (v === null || v === undefined ? '–' : `${v.toFixed(1)}°`);

    const spreadOptions = chartOptions('°F above dew point', { min: 0 });
    spreadOptions.scales.y2 = {
      position: 'right',
      title: { display: true, text: 'Station temperature (°F)' },
      grid: { drawOnChartArea: false },
    };
    spreadOptions.plugins.tooltip.callbacks.label = (item) => {
      const { dataset, raw } = item;
      if (!dataset.readings) return `${dataset.label}: ${degrees(raw.y)}`;
      const r = dataset.readings.get(raw.x);
      const detail = r ? ` (temp ${degrees(r.temp)}, dew pt ${degrees(r.dewpoint)})` : '';
      return `${dataset.label}: ${degrees(raw.y)}${detail}`;
    };

    const TEMP_COLOR = 'rgba(32, 32, 32, 0.35)';
    charts.push(new Chart(document.getElementById('spread-chart'), {
      type: 'line',
      data: {
        datasets: [
          line('My station gap', comparison.station.spread, STATION_COLOR, {
            borderWidth: 3,
            readings: readings(comparison.station.temp, comparison.station.dewpoint),
          }),
          ...comparison.lines
            .filter((f) => f.spread.length)
            .map((f) => forecastLine(f, `${f.label} gap`, f.spread, { readings: readings(f.temp, f.dewpoint) })),
          line('My station temperature (right axis)', comparison.station.temp, TEMP_COLOR, {
            yAxisID: 'y2',
            borderWidth: 1.5,
            borderDash: [4, 3],
          }),
        ],
      },
      options: spreadOptions,
      plugins: [overlays, fogBand],
    }));

    charts.push(new Chart(document.getElementById('cloud-chart'), {
      type: 'line',
      data: {
        datasets: [
          line('Station humidity', comparison.station.humidity, STATION_COLOR, { borderWidth: 3 }),
          ...comparison.lines
            .filter((f) => f.skyCover.length)
            .map((f) => forecastLine(f, `${f.label} cloud cover`, f.skyCover)),
          ...comparison.lines
            .filter((f) => f.lowCloud.length)
            .map((f) => forecastLine(f, `${f.label} low cloud`, f.lowCloud, { borderDash: [6, 4] })),
        ],
      },
      options: chartOptions('%', { min: 0, max: 100 }),
      plugins: [overlays],
    }));

    // Only on the page when there's rain to show.
    const rainCanvas = document.getElementById('rain-chart');
    if (rainCanvas) {
      const rainOptions = chartOptions('Inches in the hour', { min: 0, suggestedMax: 0.1 });
      rainOptions.scales.y2 = {
        position: 'right',
        min: 0,
        max: 100,
        title: { display: true, text: 'Chance of rain (%)' },
        grid: { drawOnChartArea: false },
      };
      rainOptions.plugins.tooltip.callbacks.label = ({ dataset, raw }) =>
        dataset.yAxisID === 'y2'
          ? `${dataset.label}: ${Math.round(raw.y)}%`
          : `${dataset.label}: ${raw.y.toFixed(2)} in`;
      charts.push(new Chart(rainCanvas, {
        type: 'line',
        data: {
          datasets: [
            {
              type: 'bar',
              label: 'My station',
              data: comparison.station.rain,
              backgroundColor: STATION_COLOR,
              barPercentage: 1,
              categoryPercentage: 0.9,
            },
            ...comparison.lines
              .filter((f) => f.rain.length)
              .map((f) => forecastLine(f, `${f.label} amount`, f.rain)),
            ...comparison.lines
              .filter((f) => f.rainChance.length)
              .map((f) => forecastLine(f, `${f.label} chance`, f.rainChance, { yAxisID: 'y2', borderDash: [6, 4] })),
          ],
        },
        options: rainOptions,
        plugins: [overlays],
      }));
    }

    buildZoomBar();
  }

  // The "Show" row: the whole range, each local calendar day in it (skipping
  // slivers of a few hours at the ends), and arrows that step to the next day when
  // a day is shown, else by the current span.
  function dayLabel(dayStart) {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const offset = Math.round((dayStart - today.getTime()) / (24 * HOUR_MS));
    const names = { '-1': 'Yesterday', 0: 'Today', 1: 'Tomorrow' };
    return names[offset] ?? new Date(dayStart).toLocaleDateString([], { weekday: 'short' });
  }

  function zoomButton(label, onClick) {
    const button = document.createElement('button');
    button.type = 'button';
    button.textContent = label;
    button.addEventListener('click', onClick);
    return button;
  }

  function buildZoomBar() {
    const bar = document.getElementById('zoom-bar');
    const heading = document.createElement('span');
    heading.textContent = 'Show:';
    bar.append(heading);

    const spans = [{ label: 'All', ...RANGE }];
    const day = new Date(RANGE.min);
    day.setHours(0, 0, 0, 0);
    while (day.getTime() < RANGE.max) {
      const dayStart = day.getTime();
      day.setDate(day.getDate() + 1);
      const min = Math.max(dayStart, RANGE.min);
      const max = Math.min(day.getTime(), RANGE.max);
      if (max - min >= 4 * HOUR_MS) spans.push({ label: dayLabel(dayStart), min, max });
    }

    stepBack = zoomButton('←', () => step(-1));
    stepBack.setAttribute('aria-label', 'Earlier');
    bar.append(stepBack);
    for (const span of spans) {
      const button = zoomButton(span.label, () => showSpan(span.min, span.max));
      zoomButtons.push({ button, span });
      bar.append(button);
    }
    stepForward = zoomButton('→', () => step(1));
    stepForward.setAttribute('aria-label', 'Later');
    bar.append(stepForward);
    updateZoomBar();
  }

  function isShown(span) {
    return Math.abs(span.min - view.min) < 60000 && Math.abs(span.max - view.max) < 60000;
  }

  function step(direction) {
    // zoomButtons[0] is "All"; the rest are the days.
    const dayIndex = zoomButtons.findIndex(({ span }, i) => i > 0 && isShown(span));
    const next = dayIndex > 0 && dayIndex + direction > 0 ? zoomButtons[dayIndex + direction] : undefined;
    if (next) {
      showSpan(next.span.min, next.span.max);
    } else {
      const width = view.max - view.min;
      showSpan(view.min + direction * width, view.max + direction * width);
    }
  }

  function updateZoomBar() {
    for (const { button, span } of zoomButtons) {
      const active = isShown(span);
      button.classList.toggle('active', active);
      button.setAttribute('aria-pressed', String(active));
    }
    if (stepBack) {
      stepBack.disabled = view.min <= RANGE.min;
      stepForward.disabled = view.max >= RANGE.max;
    }
  }
</script>
{% endblock %}
