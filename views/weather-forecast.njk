{% extends "layouts/base.njk" %}

{% block title %}Weather Forecast{% endblock %}

{% macro leadLabel(hours) %}{% if hours == 0 %}Latest{% elif hours == 24 %}1 day ahead{% else %}{{ hours }} h ahead{% endif %}{% endmacro %}

{% block content %}
<h1>My Weather</h1>
{% include "partials/weather-tabs.njk" %}

<p>
  Forecasts for my station's location from four sources, saved every hour, alongside
  what the station actually recorded. Left of the dashed "now" line, each forecast line
  shows what the source predicted in advance for that hour; right of it, its forecast
  for the hours ahead. Shading marks overnight, 10pm to 8am.
</p>

<div class="chart-options">
  <span>Range:</span>
  {% for d in rangeDays %}
  <a href="?days={{ d }}&amp;lead={{ lead }}"{% if d == days %} class="active" aria-current="true"{% endif %}>{{ d }} day{% if d > 1 %}s{% endif %}</a>
  {% endfor %}
</div>
<div class="chart-options">
  <span>Forecast made:</span>
  {% for h in leadHours %}
  <a href="?days={{ days }}&amp;lead={{ h }}"{% if h == lead %} class="active" aria-current="true"{% endif %}>{{ leadLabel(h) }}</a>
  {% endfor %}
</div>
<p class="hint">
  {% if lead == 0 %}
  "Latest" uses the newest forecast made before each hour.
  {% elif lead == 24 %}
  "1 day ahead" uses Open-Meteo's archive of forecasts made about a day before each
  hour, which covers the three models but not NWS, so the average is of the three.
  {% else %}
  "{{ leadLabel(lead) }}" uses the newest forecast made at least {{ lead }} hours before each hour,
  the forecast you'd have had that far in advance.
  {% endif %}
  Click a legend entry to show or hide a line; the individual forecasts start hidden.
</p>

{% if comparison.lines.length %}
<h2>Temperature</h2>
<div style="max-width: 900px">
  <canvas id="temp-chart"></canvas>
</div>

{% if comparison.scores.length %}
<h3>How the forecasts did</h3>
<div class="table-scroll">
  <table class="data-table">
    <thead>
      <tr><th>Forecast</th><th>Hours</th><th>Temp bias</th><th>Temp miss</th><th>Dew pt bias</th><th>Dew pt miss</th></tr>
    </thead>
    <tbody>
      {% for row in comparison.scores %}
      <tr><td>{{ row.label }}</td><td>{{ row.hours }}</td><td>{{ row.tempBias }}</td><td>{{ row.tempMiss }}</td><td>{{ row.dewpointBias }}</td><td>{{ row.dewpointMiss }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<p class="hint">
  Past hours in the range, against the station's reading at the top of each hour, sorted
  by temperature miss. Bias is the average of forecast minus actual (positive means the
  forecast ran high); miss is the average size of the error either way. The average is an
  equal-weight mean of the four sources.
</p>
{% endif %}

<h2>Forecasts made in advance</h2>
<p>
  How one forecast changed as each hour got closer: its forecast made about a day
  before (the models only), 12 hours before, 6 hours before and about an hour before,
  against what the station recorded.
</p>
<div class="chart-options" id="lead-sources">
  <span>Forecast:</span>
  {% for f in comparison.leadComparison %}
  <button type="button" data-key="{{ f.key }}"{% if loop.first %} class="active" aria-pressed="true"{% else %} aria-pressed="false"{% endif %}>{{ f.label }}</button>
  {% endfor %}
</div>
<div style="max-width: 900px">
  <canvas id="lead-chart"></canvas>
</div>

<h2>Gap between temperature and dew point</h2>
<div style="max-width: 900px">
  <canvas id="spread-chart"></canvas>
</div>
<p class="hint">
  How far the air is from saturation. When the temperature falls to within
  {{ comparison.fogSpreadF }}°F of the dew point (the shaded band at the bottom), dew or
  fog is likely. Forecast lines use each source's own temperature and dew point. The
  faint dashed line is the station's temperature, on the right-hand scale; hover over a
  point to see the temperature and dew point behind each gap.
</p>

<h2>Clouds</h2>
<div style="max-width: 900px">
  <canvas id="cloud-chart"></canvas>
</div>
<p class="hint">
  Solid lines are total cloud cover; dashed lines are low cloud (fog and marine layer),
  which only HRRR and ECMWF forecast, so the average leaves it out. Station humidity near
  100% usually means fog.
</p>

<p class="hint">
  Forecasts last fetched: <span class="local-time" data-iso="{{ comparison.lastFetchedAt }}"></span>
</p>
{% else %}
<p>No forecast data yet.</p>
{% endif %}

<h2>Sources</h2>
<ul>
  <li><strong>NWS</strong>: the National Weather Service's forecast for the area.</li>
  <li><strong>HRRR</strong>: NOAA's High-Resolution Rapid Refresh model (3 km grid, updated hourly).</li>
  <li><strong>NBM</strong>: NOAA's National Blend of Models, a blend of many models (2.5 km).</li>
  <li><strong>ECMWF</strong>: the European Centre's global model (about 25 km).</li>
</ul>
<p class="hint">
  Forecast data from the National Weather Service and
  <a href="https://open-meteo.com/">Open-Meteo.com</a> (HRRR, NBM and ECMWF).
</p>
{% endblock %}

{% block head %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
{% endblock %}

{% block scripts %}
<script>
  for (const el of document.querySelectorAll('.local-time')) {
    el.textContent = new Intl.DateTimeFormat(undefined, {
      month: 'numeric',
      day: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
    }).format(new Date(el.dataset.iso));
  }

  const comparison = {{ comparison | dump | safe }};
  const days = {{ days }};
  const COLORS = {
    average: '#8a8a8a',
    nws: '#1a73e8',
    om_hrrr: '#d93025',
    om_nbm: '#188038',
    om_ecmwf: '#e37400',
  };
  const STATION_COLOR = '#202020';

  // Overnight shading behind the lines, and a dashed vertical line at the current time.
  const overlays = {
    id: 'overlays',
    beforeDatasetsDraw(chart) {
      const { ctx, chartArea } = chart;
      const x = chart.scales.x;
      ctx.save();
      ctx.fillStyle = 'rgba(60, 80, 140, 0.08)';
      for (const night of comparison.nights) {
        const left = Math.max(x.getPixelForValue(Date.parse(night.start)), chartArea.left);
        const right = Math.min(x.getPixelForValue(Date.parse(night.end)), chartArea.right);
        if (right > left) {
          ctx.fillRect(left, chartArea.top, right - left, chartArea.bottom - chartArea.top);
        }
      }
      ctx.restore();
    },
    afterDatasetsDraw(chart) {
      const nowX = chart.scales.x.getPixelForValue(Date.parse(comparison.now));
      const { top, bottom } = chart.chartArea;
      const { ctx } = chart;
      ctx.save();
      ctx.strokeStyle = '#888';
      ctx.setLineDash([4, 4]);
      ctx.beginPath();
      ctx.moveTo(nowX, top);
      ctx.lineTo(nowX, bottom);
      ctx.stroke();
      ctx.restore();
    },
  };

  function line(label, data, color, extra = {}) {
    return { label, data, borderColor: color, backgroundColor: color, pointRadius: 0, borderWidth: 2, ...extra };
  }

  // The average is shown and drawn thicker; the individual sources start hidden.
  function forecastLine(forecast, label, data, extra = {}) {
    const isAverage = forecast.key === 'average';
    return line(label, data, COLORS[forecast.key], {
      borderWidth: isAverage ? 3 : 2,
      hidden: !isAverage,
      ...extra,
    });
  }

  function chartOptions(yTitle, yExtra = {}) {
    return {
      interaction: { mode: 'nearest', axis: 'x', intersect: false },
      scales: {
        x: {
          type: 'time',
          min: comparison.range.start,
          max: comparison.range.end,
          time: {
            unit: days > 1 ? 'day' : 'hour',
            displayFormats: { hour: 'ha', day: 'EEE M/d' },
            tooltipFormat: 'EEE h a',
          },
        },
        y: { title: { display: true, text: yTitle }, ...yExtra },
      },
    };
  }

  if (comparison.lines.length) {
    new Chart(document.getElementById('temp-chart'), {
      type: 'line',
      data: {
        datasets: [
          line('My station', comparison.station.temp, STATION_COLOR, { borderWidth: 3 }),
          ...comparison.lines.map((f) => forecastLine(f, f.label, f.temp)),
        ],
      },
      options: chartOptions('°F'),
      plugins: [overlays],
    });

    // Darker and solid for the shortest lead, lighter and dotted for the longest.
    const LEAD_STYLES = {
      0: { alpha: 1, dash: [], label: 'Latest (about 1 h ahead)' },
      6: { alpha: 0.65, dash: [8, 4], label: '6 h ahead' },
      12: { alpha: 0.4, dash: [2, 3], label: '12 h ahead' },
      24: { alpha: 0.25, dash: [1, 3], label: '1 day ahead' },
    };

    function withAlpha(hex, alpha) {
      const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
      return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    }

    function leadDatasets(key) {
      const forecast = comparison.leadComparison.find((f) => f.key === key);
      return [
        line('My station', comparison.station.temp, STATION_COLOR, { borderWidth: 3 }),
        ...forecast.leads.map(({ lead, temp }) => {
          const style = LEAD_STYLES[lead];
          return line(`${forecast.label} ${style.label}`, temp, withAlpha(COLORS[key], style.alpha), {
            borderDash: style.dash,
          });
        }),
      ];
    }

    const leadChart = new Chart(document.getElementById('lead-chart'), {
      type: 'line',
      data: { datasets: leadDatasets(comparison.leadComparison[0].key) },
      options: chartOptions('°F'),
      plugins: [overlays],
    });

    for (const button of document.querySelectorAll('#lead-sources button')) {
      button.addEventListener('click', () => {
        for (const other of document.querySelectorAll('#lead-sources button')) {
          other.classList.toggle('active', other === button);
          other.setAttribute('aria-pressed', String(other === button));
        }
        leadChart.data.datasets = leadDatasets(button.dataset.key);
        leadChart.update();
      });
    }

    // Band from 0 up to the fog threshold, drawn behind the lines.
    const fogBand = {
      id: 'fogBand',
      beforeDatasetsDraw(chart) {
        const { ctx, chartArea } = chart;
        const y = chart.scales.y;
        const top = Math.max(y.getPixelForValue(comparison.fogSpreadF), chartArea.top);
        const bottom = Math.min(y.getPixelForValue(0), chartArea.bottom);
        ctx.save();
        ctx.fillStyle = 'rgba(120, 120, 120, 0.15)';
        ctx.fillRect(chartArea.left, top, chartArea.right - chartArea.left, bottom - top);
        ctx.fillStyle = '#555';
        ctx.font = '12px sans-serif';
        ctx.textBaseline = 'middle';
        ctx.fillText('Dew or fog likely', chartArea.left + 6, (top + bottom) / 2);
        ctx.restore();
      },
    };

    // Temperature and dew point by timestamp, for the tooltip of each gap line.
    function readings(temp, dewpoint) {
      const byX = new Map(temp.map((p) => [p.x, { temp: p.y, dewpoint: null }]));
      for (const p of dewpoint) {
        const r = byX.get(p.x);
        if (r) r.dewpoint = p.y;
      }
      return byX;
    }

    const degrees = (v) => (v === null || v === undefined ? '–' : `${v.toFixed(1)}°`);

    const spreadOptions = chartOptions('°F above dew point', { min: 0 });
    spreadOptions.scales.y2 = {
      position: 'right',
      title: { display: true, text: 'Station temperature (°F)' },
      grid: { drawOnChartArea: false },
    };
    spreadOptions.plugins = {
      tooltip: {
        callbacks: {
          label(item) {
            const { dataset, raw } = item;
            if (!dataset.readings) return `${dataset.label}: ${degrees(raw.y)}`;
            const r = dataset.readings.get(raw.x);
            const detail = r ? ` (temp ${degrees(r.temp)}, dew pt ${degrees(r.dewpoint)})` : '';
            return `${dataset.label}: ${degrees(raw.y)}${detail}`;
          },
        },
      },
    };

    const TEMP_COLOR = 'rgba(32, 32, 32, 0.35)';
    new Chart(document.getElementById('spread-chart'), {
      type: 'line',
      data: {
        datasets: [
          line('My station gap', comparison.station.spread, STATION_COLOR, {
            borderWidth: 3,
            readings: readings(comparison.station.temp, comparison.station.dewpoint),
          }),
          ...comparison.lines.map((f) =>
            forecastLine(f, `${f.label} gap`, f.spread, { readings: readings(f.temp, f.dewpoint) })
          ),
          line('My station temperature (right axis)', comparison.station.temp, TEMP_COLOR, {
            yAxisID: 'y2',
            borderWidth: 1.5,
            borderDash: [4, 3],
          }),
        ],
      },
      options: spreadOptions,
      plugins: [overlays, fogBand],
    });

    new Chart(document.getElementById('cloud-chart'), {
      type: 'line',
      data: {
        datasets: [
          line('Station humidity', comparison.station.humidity, STATION_COLOR, { borderWidth: 3 }),
          ...comparison.lines.map((f) => forecastLine(f, `${f.label} cloud cover`, f.skyCover)),
          ...comparison.lines
            .filter((f) => f.lowCloud.length)
            .map((f) => forecastLine(f, `${f.label} low cloud`, f.lowCloud, { borderDash: [6, 4] })),
        ],
      },
      options: chartOptions('%', { min: 0, max: 100 }),
      plugins: [overlays],
    });
  }
</script>
{% endblock %}
